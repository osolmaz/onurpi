{
  "name": "@onurpi/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/turn-fold/index.ts",
      "./packages/goal/index.ts",
      "./packages/live-stats/index.ts",
      "./packages/nyan-mode/index.ts",
      "./packages/prompt-queue/index.ts",
      "./packages/reliable-compaction/index.ts",
      "./packages/context-window-policy/index.ts",
      "./packages/startup-model/index.ts",
      "./packages/infinite-retry/index.ts",
      "./packages/codex-usage/index.ts",
      "./packages/plan-checklist/index.ts",
      "./packages/unified-exec/index.ts",
      "./node_modules/pi-huggingface-oauth/index.ts",
      "./node_modules/pi-must-win/index.ts",
      "./node_modules/pi-regraft/extensions/regraft.ts",
      "./node_modules/pi-workflows/src/extension/index.ts",
      "./node_modules/pi-demo-mode/extensions/demo-mode.ts"
    ],
    "skills": [
      "./packages/goal/skills",
      "./packages/regrafter-driver/skills"
    ],
    "themes": [
      "./packages/onur-theme/themes/onur-dark.json"
    ]
  },
  "dependencies": {
    "pi-demo-mode": "https://codeload.github.com/osolmaz/pi-demo-mode/tar.gz/8f18a3802a786be797404eb0a4ee3cce8a522b75",
    "pi-huggingface-oauth": "0.1.1",
    "pi-must-win": "0.2.0",
    "pi-regraft": "0.2.0",
    "@osolmaz/regrafter": "https://github.com/osolmaz/regrafter/releases/download/v0.1.0/osolmaz-regrafter-0.1.0.tgz",
    "pi-workflows": "https://codeload.github.com/osolmaz/pi-workflows/tar.gz/630622e44fcd486690b6bcb923b4d18dc516723e"
  },
  "bundledDependencies": [
    "pi-demo-mode",
    "pi-huggingface-oauth",
    "pi-must-win",
    "pi-regraft",
    "pi-workflows",
    "@osolmaz/regrafter"
  ],
  "scripts": {
    "settings:sync": "node scripts/sync-settings.ts sync",
    "settings:reset": "node scripts/sync-settings.ts reset",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dry": "slophammer-ts dry .",
    "mutate": "stryker run",
    "slophammer": "sh scripts/run-slophammer.sh",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run dry"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@eslint/js": "9.39.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "slophammer-ts": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "3.2.7"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
