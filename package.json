{
  "name": "@onurpi/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/prompt-queue/index.ts",
      "./packages/restart/index.ts",
      "./packages/turn-fold/index.ts",
      "./packages/loop-guard/index.ts",
      "./packages/goal/index.ts",
      "./packages/live-stats/index.ts",
      "./packages/nyan-mode/index.ts",
      "./packages/codex-switcher/index.ts",
      "./packages/context-window-policy/index.ts",
      "./packages/pi-codex-compaction/index.ts",
      "./packages/reliable-compaction/index.ts",
      "./packages/infinite-retry/index.ts",
      "./packages/pi-usage/index.ts",
      "./packages/plan-checklist/index.ts",
      "./packages/unified-exec/index.ts",
      "./packages/yarp/index.ts",
      "./packages/huggingface-oauth/index.ts",
      "./packages/pi-must-win/index.ts",
      "./packages/regrafter-driver/index.ts",
      "./packages/workflows/index.ts",
      "./packages/onur-openclaw-maintainer/index.ts",
      "./packages/demo-mode/index.ts",
      "./packages/skill-slug/index.ts"
    ],
    "skills": [
      "./packages/agents/skills/*/SKILL.md",
      "./packages/goal/skills",
      "./packages/regrafter-driver/skills"
    ],
    "themes": [
      "./packages/onur-theme/themes/onur-dark.json"
    ]
  },
  "scripts": {
    "agents:sync": "npm run sync --workspace @onurpi/agents --",
    "agents:check": "npm run check-sync --workspace @onurpi/agents --",
    "agents:sync-simpledoc": "npm run sync-simpledoc --workspace @onurpi/agents --",
    "settings:sync": "node scripts/sync-settings.ts sync",
    "settings:reset": "node scripts/sync-settings.ts reset",
    "workflows:sync": "npm run sync --workspace @onurpi/workflows",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dry": "slophammer-ts dry .",
    "mutate": "stryker run",
    "slophammer": "sh scripts/run-slophammer.sh",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run dry"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@eslint/js": "9.39.2",
    "@osolmaz/pi-workflows": "git+https://github.com/osolmaz/pi-workflows.git#5ad289e69a4cb1dca9a7055cbd642572de458451",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "slophammer-ts": "0.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "3.2.7"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
